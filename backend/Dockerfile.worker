# Production Dockerfile for Celery GPU Inference Workers
# Includes NVIDIA CUDA runtime and PyTorch for CatVTON diffusion execution.

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV APP_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    git \
    ffmpeg \
    libsm6 \
    libxext6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.10 /usr/bin/python

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source and CatVTON modules
COPY app/ ./app/
COPY CatVTON/ ./CatVTON/
COPY pyproject.toml .

# Celery GPU worker: concurrency 1 to prevent multiple processes contending for GPU VRAM
CMD ["celery", "-A", "app.workers.celery_app.celery_app", "worker", "-Q", "gpu", "-c", "1", "--loglevel=INFO"]
