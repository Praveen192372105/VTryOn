# =============================================================================
# V Try-On Platform — Environment Configuration Template (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Virtual Try-On API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (MySQL 8.x / XAMPP)
# For local XAMPP: root user with empty password on port 3306
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/vtryon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -----------------------------------------------------------------------------
# Redis & Celery Workers
# Redis logical database separation:
#   DB 0 -> Application transient cache
#   DB 1 -> Celery job broker
#   DB 2 -> Celery job results
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_DEFAULT_QUEUE=default
CELERY_GPU_QUEUE=gpu
CELERY_GPU_SOFT_TIME_LIMIT_SECONDS=240
CELERY_GPU_TIME_LIMIT_SECONDS=300
CELERY_VISIBILITY_TIMEOUT_SECONDS=1800
CELERY_GPU_MAX_RETRIES=2
CELERY_GPU_RETRY_BASE_SECONDS=10

# -----------------------------------------------------------------------------
# Authentication & JWT Security
# In production: JWT_SECRET MUST be a strong random secret with at least 32 characters
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET=vtryon_development_secret_key_super_secure_long_random_string_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# -----------------------------------------------------------------------------
# Media & Storage Configuration
# -----------------------------------------------------------------------------
MEDIA_ROOT=./storage
MEDIA_BASE_URL=/media
MAX_UPLOAD_MB=12
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# CatVTON AI Engine Configuration
# Verified against CatVTON repository:
#   Device: cuda (with cpu fallback for non-GPU dev)
#   Precision: bf16 (native bfloat16)
#   Resolution: 768x1024
#   Max Concurrency: 1 (GPU worker serialization)
# -----------------------------------------------------------------------------
CATVTON_ROOT=./CatVTON
CATVTON_DEVICE=cuda
CATVTON_DTYPE=bf16
CATVTON_WIDTH=768
CATVTON_HEIGHT=1024
CATVTON_MAX_CONCURRENCY=1
CATVTON_CHECKPOINT_DIR=zhengchong/CatVTON
CATVTON_BASE_MODEL=booksforcharlie/stable-diffusion-inpainting
CATVTON_INFERENCE_STEPS=40
CATVTON_GUIDANCE_SCALE=2.5
CATVTON_ALLOW_TF32=true
CATVTON_REPAINT=false

# -----------------------------------------------------------------------------
# CORS Configuration (Web Frontend)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# -----------------------------------------------------------------------------
# Rate Limiting & Resource Admission Control (Phase 13)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=vtryon:rate
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=30
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_TRYON_PER_MINUTE=8

# Try-on concurrency & global capacity bounds
MAX_ACTIVE_TRYONS_PER_USER=2
MAX_QUEUED_TRYONS_GLOBAL=100
ADMISSION_LOCK_TTL_SECONDS=10
TRUSTED_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# Scalability, Storage & Production Evolution (Phase 14)
# -----------------------------------------------------------------------------
# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SLOW_QUERY_MS=500

# Storage Backend Abstraction (local or s3)
STORAGE_BACKEND=local
# S3_BUCKET_NAME=vtryon-media-prod
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
PRIVATE_MEDIA_URL_TTL_SECONDS=300

# Model Versioning & Generative Provenance
CATVTON_MODEL_VERSION=catvton-1.0-v1
INFERENCE_CONFIG_VERSION=v1-accurate

# Observability & Metrics
METRICS_ENABLED=true


