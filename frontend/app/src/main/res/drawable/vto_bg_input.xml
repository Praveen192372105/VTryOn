<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vto_radius_md" />
            <solid android:color="@color/vto_surface_primary" />
            <stroke android:width="1.5dp" android:color="@color/vto_border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vto_radius_md" />
            <solid android:color="@color/vto_surface_primary" />
            <stroke android:width="1dp" android:color="@color/vto_border_default" />
        </shape>
    </item>
</selector>
