<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vto_radius_pill" />
            <solid android:color="@color/vto_control_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vto_radius_pill" />
            <solid android:color="@color/vto_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/vto_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vto_radius_pill" />
            <solid android:color="@color/vto_surface_secondary" />
            <stroke android:width="1dp" android:color="@color/vto_border_subtle" />
        </shape>
    </item>
</selector>
