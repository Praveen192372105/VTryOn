<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vto_surface_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vto_brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vto_surface_secondary" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vto_border_default" />
        </shape>
    </item>
</selector>
