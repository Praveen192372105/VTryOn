<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/surface_secondary" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/btn_secondary_pressed" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/btn_secondary_bg" />
            <stroke android:width="1dp" android:color="@color/border_default" />
        </shape>
    </item>
</selector>
