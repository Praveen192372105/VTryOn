<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_tryon"
    app:startDestination="@id/tryOnFragment">

    <argument
        android:name="outfitId"
        app:argType="string"
        app:nullable="true"
        android:defaultValue="@null" />

    <fragment
        android:id="@+id/tryOnFragment"
        android:name="com.example.vtryon.feature.tryon.TryOnFragment"
        android:label="Try-On Studio">
        <argument
            android:name="outfitId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="personUri"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_tryon_to_processing"
            app:destination="@id/tryOnProcessingFragment" />
        <action
            android:id="@+id/action_tryOn_to_result"
            app:destination="@id/resultFragment" />
        <action
            android:id="@+id/action_tryon_to_outfits"
            app:destination="@id/outfitsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tryOnProcessingFragment"
        android:name="com.example.vtryon.feature.tryon.processing.TryOnProcessingFragment"
        android:label="Generating Look">
        <argument
            android:name="jobId"
            app:argType="string" />
        <action
            android:id="@+id/action_processing_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/tryOnProcessingFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
