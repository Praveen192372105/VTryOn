<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Editorial Typography Hierarchy -->
    <style name="TextAppearance.VTryOn.DisplayLarge" parent="android:TextAppearance">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.VTryOn.DisplayMedium" parent="android:TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.VTryOn.HeadlineLarge" parent="android:TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/vto_content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <style name="TextAppearance.VTryOn.HeadlineMedium" parent="android:TextAppearance">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/vto_content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.VTryOn.HeadlineSmall" parent="android:TextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/vto_content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.008</item>
    </style>

    <style name="TextAppearance.VTryOn.TitleLarge" parent="android:TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.VTryOn.TitleMedium" parent="android:TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.VTryOn.TitleSmall" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.VTryOn.BodyLarge" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.VTryOn.BodyMedium" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/content_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.VTryOn.BodySmall" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/content_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.VTryOn.Caption" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/content_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.VTryOn.LabelLarge" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.VTryOn.LabelMedium" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/content_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.VTryOn.LabelSmall" parent="android:TextAppearance">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/content_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.VTryOn.Metadata" parent="android:TextAppearance">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/content_tertiary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Bottom Sheet Slide Animation -->
    <style name="Animation.Vto.BottomSheet" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/vto_slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/vto_slide_out_bottom</item>
    </style>
</resources>
