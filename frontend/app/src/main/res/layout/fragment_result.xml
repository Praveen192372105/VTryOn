<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vto_surface_primary">

    <com.example.vtryon.core.designsystem.component.toolbar.VtoTopBar
        android:id="@+id/resultToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vtoShowBack="true"
        app:vtoSubtitle="Generated Look"
        app:vtoTitle="Try-On Result" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomActionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resultToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/vto_space_md"
            android:paddingVertical="@dimen/vto_space_sm">

            <com.example.vtryon.core.designsystem.component.MediaSurfaceView
                android:id="@+id/ivResult"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                app:mediaCornerRadius="@dimen/vto_radius_lg" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vto_space_md"
                android:textAppearance="@style/TextAppearance.VTryOn.HeadlineSmall"
                android:textColor="@color/vto_content_primary"
                tools:text="Status: Completed" />

            <TextView
                android:id="@+id/tvJobId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vto_space_xs"
                android:textAppearance="@style/TextAppearance.VTryOn.Caption"
                android:textColor="@color/vto_content_tertiary"
                tools:text="Job ID: 01jseedtryon000000000001" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vto_surface_secondary"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/vto_space_md"
        android:paddingVertical="@dimen/vto_space_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.example.vtryon.core.designsystem.component.AppButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:btnText="Try Another Look"
            app:btnVariant="primary" />

    </LinearLayout>

    <com.example.vtryon.core.designsystem.component.feedback.VtoProgressRing
        android:id="@+id/loadingIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
