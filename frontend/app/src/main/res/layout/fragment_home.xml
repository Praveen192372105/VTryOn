<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vto_background">

    <!-- Top Header Bar (Matching Web Editorial Header) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/vto_surface_primary"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/userProfileBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvWelcomeSubtitle"
                style="@style/TextAppearance.VTryOn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="VIRTUAL FITTING STUDIO"
                android:textColor="@color/vto_brand"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserName"
                style="@style/TextAppearance.VTryOn.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/vto_content_primary"
                android:textStyle="bold"
                tools:text="Eswar Chinthakayala" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/vto_border_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Scrollable Dashboard -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16">

            <!-- 1. Master Virtual Try-On Hero Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHeroStudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_hero"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_20">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    style="@style/TextAppearance.VTryOn.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Virtual Try-On"
                    android:textColor="@color/vto_content_primary"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    style="@style/TextAppearance.VTryOn.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:lineSpacingExtra="3dp"
                    android:text="Choose your photo and a garment to preview your look with natural fit and fabric texture."
                    android:textColor="@color/vto_content_secondary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

                <!-- Action Button -->
                <com.example.vtryon.core.designsystem.component.AppButton
                    android:id="@+id/btnStartTryOn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    app:btnText="Open Studio"
                    app:btnVariant="primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeroSubtitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Responsive Equal-Width & Equal-Height Style Category Cards -->
            <TextView
                style="@style/TextAppearance.VTryOn.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="Explore Categories"
                android:textColor="@color/vto_content_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:orientation="horizontal">

                <!-- Card 1: Tops -->
                <LinearLayout
                    android:id="@+id/cardCatTops"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_quick_cat"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_8">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/vto_huge_shirt_01"
                        app:tint="@color/vto_brand" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Tops"
                        android:textColor="@color/vto_content_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shirts &amp; Outerwear"
                        android:textColor="@color/vto_content_tertiary"
                        android:textSize="9sp" />

                </LinearLayout>

                <!-- Card 2: Bottoms -->
                <LinearLayout
                    android:id="@+id/cardCatBottoms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_quick_cat"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_8">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/vto_huge_grid_view"
                        app:tint="@color/vto_brand" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Bottoms"
                        android:textColor="@color/vto_content_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pants &amp; Skirts"
                        android:textColor="@color/vto_content_tertiary"
                        android:textSize="9sp" />

                </LinearLayout>

                <!-- Card 3: Dresses -->
                <LinearLayout
                    android:id="@+id/cardCatDresses"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_quick_cat"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_8">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/vto_huge_sparkles"
                        app:tint="@color/vto_brand" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Dresses"
                        android:textColor="@color/vto_content_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gowns &amp; One-Pieces"
                        android:textColor="@color/vto_content_tertiary"
                        android:textSize="9sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 3. Trending Collection Carousel Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24">

                <TextView
                    android:id="@+id/tvTrendingTitle"
                    style="@style/TextAppearance.VTryOn.HeadlineSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trending Collection"
                    android:textColor="@color/vto_content_primary"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTrendingSubtitle"
                    style="@style/TextAppearance.VTryOn.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Select any piece to start fitting"
                    android:textColor="@color/vto_content_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTrendingTitle" />

                <TextView
                    android:id="@+id/btnViewAllTrending"
                    style="@style/TextAppearance.VTryOn.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_6"
                    android:text="Browse All"
                    android:textColor="@color/vto_brand"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Horizontal Trending Outfits Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrendingOutfits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_trending_outfit" />

            <!-- 4. Equal-Width, Equal-Height Experience Cards (2 Columns) -->
            <TextView
                style="@style/TextAppearance.VTryOn.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="Studio Experience"
                android:textColor="@color/vto_content_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_16"
                android:orientation="horizontal">

                <!-- Experience Card 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_stat_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/vto_huge_camera_01"
                        app:tint="@color/vto_brand" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Instant Portrait"
                        android:textColor="@color/vto_content_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Upload or choose sample models in one tap"
                        android:textColor="@color/vto_content_secondary"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Experience Card 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_stat_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/vto_huge_checkmark_circle_02"
                        app:tint="@color/vto_brand" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Realistic Drape"
                        android:textColor="@color/vto_content_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.VTryOn.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Adapts fabric drape to natural pose and lighting"
                        android:textColor="@color/vto_content_secondary"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
