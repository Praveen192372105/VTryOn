<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_8"
    android:background="@drawable/bg_surface_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_8">

    <com.example.vtryon.core.designsystem.component.MediaSurfaceView
        android:id="@+id/ivHistoryResult"
        android:layout_width="74dp"
        android:layout_height="100dp"
        app:mediaCornerRadius="@dimen/radius_md" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_10"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryCategory"
                style="@style/TextAppearance.VTryOn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="UPPER BODY"
                android:textColor="@color/vto_brand"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHistoryStatus"
                style="@style/TextAppearance.VTryOn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPLETED"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryTitle"
            style="@style/TextAppearance.VTryOn.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Virtual Fitting Look"
            android:textColor="@color/vto_content_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistorySubtitle"
            style="@style/TextAppearance.VTryOn.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:text="Saved Virtual Look"
            android:textColor="@color/text_secondary" />

        <!-- Quick Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnHistoryTryAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/vto_bg_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/vto_huge_refresh_01"
                    app:tint="@color/vto_content_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Try Again"
                    android:textColor="@color/vto_content_primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHistorySave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/vto_bg_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:id="@+id/ivSaveIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/vto_huge_bookmark_01"
                    app:tint="@color/vto_content_primary" />

                <TextView
                    android:id="@+id/tvSaveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Save"
                    android:textColor="@color/vto_content_primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHistoryDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/vto_bg_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/vto_huge_delete_02"
                    app:tint="@color/vto_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Delete"
                    android:textColor="@color/vto_error"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
